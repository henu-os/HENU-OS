#!/bin/sh
# HENU OS 3.0 Live-Build Chroot Hook: Theme & Branding Activation

set -e

echo "[HENU HOOK] Configuring Plymouth theme..."
if [ -d "/usr/share/plymouth/themes/henu" ]; then
    plymouth-set-default-theme henu -R || true
fi

echo "[HENU HOOK] Compiling dconf GSettings schemas..."
if [ -d "/usr/share/glib-2.0/schemas" ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas || true
fi

echo "[HENU HOOK] Branding activation complete."
