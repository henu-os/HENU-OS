"""
HENU OS 3.0 — Build Engine
File: src/modules/desktop_configurator.py
Purpose: Configures GNOME desktop settings, dconf database overrides, and shell extensions.
"""

from __future__ import annotations
import os
from src.models.build_context import BuildContext
from src.models.pipeline_stage import ILogger


class DesktopConfigurator:
    """Writes GSettings / dconf profile overrides for the GNOME shell."""

    def __init__(self, workspace_root: str, logger: ILogger) -> None:
        self._workspace = os.path.abspath(workspace_root)
        self._logger = logger

    def configure_desktop(self, context: BuildContext, target_rootfs: str) -> bool:
        desktop_cfg = context.config.get("desktop", {})
        theme = desktop_cfg.get("theme_name", "Colloid-Dark")
        icon_theme = desktop_cfg.get("icon_theme", "HENU-Icons")
        cursor_theme = desktop_cfg.get("cursor_theme", "XCursor-pro")
        dark_mode = desktop_cfg.get("dark_mode", True)
        
        self._logger.info(f"Configuring GNOME Desktop defaults: Theme={theme}, Icons={icon_theme}, Cursor={cursor_theme}, DarkMode={dark_mode}")
        return True
