Thumbs.db

# Virtual environments
.venv/
venv/
ENV/

# Development tooling
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.gemini/
.agents/

# Package manager outputs
node_modules/
__pycache__/
*.pyc

# Local OS files
lost+found/
